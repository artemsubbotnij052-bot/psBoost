@echo off
setlocal EnableExtensions
chcp 65001 >nul
 title PCBoost - One File Launcher
set "PCBOOST_SELF=%~f0"
set "PCBOOST_HOME=%LOCALAPPDATA%\Programs\PCBoost"
set "PCBOOST_ZIP=%TEMP%\PCBoost_embedded_payload.zip"
echo ========================================
echo       PCBoost - Liquid Glass
echo ========================================
echo.
echo Preparing PCBoost from this single file...
where powershell.exe >nul 2>&1
if errorlevel 1 (
  echo [ERROR] Windows PowerShell was not found.
  pause
  exit /b 1
)
powershell.exe -NoProfile -Command "$s=[IO.File]::ReadAllText($env:PCBOOST_SELF); $m='__PCBOOST_PAYLOAD__'; $i=$s.LastIndexOf($m); if($i -lt 0){throw 'Embedded application payload missing'}; $b=($s.Substring($i+$m.Length) -replace '\s',''); [IO.File]::WriteAllBytes($env:PCBOOST_ZIP,[Convert]::FromBase64String($b))"
if errorlevel 1 (
  echo [ERROR] Could not unpack the embedded PCBoost data.
  pause
  exit /b 1
)
if not exist "%PCBOOST_HOME%" mkdir "%PCBOOST_HOME%"
powershell.exe -NoProfile -Command "Expand-Archive -LiteralPath $env:PCBOOST_ZIP -DestinationPath $env:PCBOOST_HOME -Force"
if errorlevel 1 (
  echo [ERROR] Could not extract PCBoost.
  pause
  exit /b 1
)
del "%PCBOOST_ZIP%" >nul 2>&1
set "PCBOOST_APP=%PCBOOST_HOME%\PCBoost_EXACT_DASHBOARD"
if not exist "%PCBOOST_APP%\run.bat" (
  echo [ERROR] PCBoost launcher was not found after extraction.
  pause
  exit /b 1
)
echo.
echo PCBoost is ready. Starting...
start "PCBoost" "%PCBOOST_APP%\run.bat"
exit /b 0
